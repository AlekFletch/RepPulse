<!-- Preparation, active set, pause and exit confirmation (spec 2.3–2.5) share one page and switch
     by state (`if`: only the visible view is built, which matters on the ~100 KB JS heap).
     The rest between sets is the `rest` page. -->
<div class="page" onswipe="onSwipe">
    <!-- PreparationScreen -->
    <div class="view" if="{{vPrepare}}">
        <image class="hero-icon" src="{{iconHero}}"></image>
        <text class="caption">{{ $t('strings.getReady') }}</text>
        <text class="countdown">{{countdownText}}</text>
    </div>

    <!-- ActiveWorkoutScreen -->
    <div class="view" if="{{vActive}}">
        <div class="top-row">
            <image class="small-icon" src="{{iconSmall}}"></image>
            <text class="top-text">{{topText}}</text>
        </div>
        <text class="set-label">{{setLabel}}</text>
        <text class="counter" onclick="onCounterTap">{{repsText}}</text>
        <text class="line-accent">{{targetText}}</text>
        <text class="line">{{timeText}}</text>
        <text class="line-dim">{{cadenceText}}</text>
        <text class="note">{{noteText}}</text>
        <div class="button" onclick="pause">
            <text class="button-text">{{ $t('strings.pause') }}</text>
        </div>
    </div>

    <!-- PauseScreen -->
    <div class="view" if="{{vPaused}}">
        <text class="caption">{{ $t('strings.pause') }}</text>
        <text class="counter-paused">{{repsText}}</text>
        <div class="row">
            <div class="half" onclick="minusRep">
                <text class="half-text">{{ $t('strings.minusRep') }}</text>
            </div>
            <div class="half" onclick="plusRep">
                <text class="half-text">{{ $t('strings.plusRep') }}</text>
            </div>
        </div>
        <div class="button" onclick="resume">
            <text class="button-text">{{ $t('strings.resume') }}</text>
        </div>
        <div class="button-dark" onclick="finish">
            <text class="button-dark-text">{{ $t('strings.finish') }}</text>
        </div>
    </div>

    <!-- Swipe right during a workout asks first (the workout is paused meanwhile). -->
    <div class="view" if="{{vConfirm}}">
        <text class="caption-wide">{{ $t('strings.exitWorkoutConfirm') }}</text>
        <text class="line-two">{{ $t('strings.exitWorkoutHint') }}</text>
        <div class="row">
            <div class="half" onclick="cancelExit">
                <text class="half-text">{{ $t('strings.no') }}</text>
            </div>
            <div class="half-danger" onclick="confirmExit">
                <text class="half-danger-text">{{ $t('strings.yes') }}</text>
            </div>
        </div>
    </div>
</div>
